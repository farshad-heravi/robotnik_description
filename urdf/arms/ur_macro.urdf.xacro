<?xml version="1.0" ?>
<robot
  name="ur_macro"
  xmlns:xacro="http://wiki.ros.org/xacro">
  <!-- TODO: Restore simulation functionality, removed jazzy -->
  <xacro:include
    filename="$(find ur_description)/urdf/ur_macro.xacro" />
  <!-- <xacro:include filename="$(find campetella_sim)/models/2f_85/urdf/robotiq_2f_85_macro.urdf.xacro" /> -->
  <!-- <xacro:include filename="$(find campetella_sim)/models/sd_35/urdf/sd_35_macro.urdf.xacro" /> -->

  <xacro:property name="initial_positions" value="${xacro.load_yaml('initial_positions.yaml')}"/>
  
  <xacro:macro
    name="arm_ur"
    params="
    ur_type
    frame_prefix
    *origin
    parent
    gazebo_ignition:=true
    end_effector:='none'
    ">
    <xacro:property
      name="joint_limit_params"
      default="$(find ur_description)/config/$(arg ur_type)/joint_limits.yaml" />
    <xacro:property
      name="kinematics_params"
      default="$(find ur_description)/config/$(arg ur_type)/default_kinematics.yaml" />
    <xacro:property
      name="physical_params"
      default="$(find ur_description)/config/$(arg ur_type)/physical_parameters.yaml" />
    <xacro:property
      name="visual_params"
      default="$(find ur_description)/config/$(arg ur_type)/visual_parameters.yaml" />

    <xacro:ur_robot
      name="${ur_type}"
      tf_prefix="${frame_prefix}"
      parent="${parent}"
      joint_limits_parameters_file="${joint_limit_params}"
      kinematics_parameters_file="${kinematics_params}"
      physical_parameters_file="${physical_params}"
      visual_parameters_file="${visual_params}">
      <xacro:insert_block name="origin" />
    </xacro:ur_robot>


    <!-- Onrobot RG6 -->
    <xacro:if value="${end_effector == 'rg6'}">
      <xacro:include filename="$(find onrobot_rg_description)/urdf/onrobot_rg6_model_macro.xacro" />
      <xacro:onrobot_rg6 prefix="${frame_prefix}rg6_" gazebo_ignition="${gazebo_ignition}"/>
      <joint name="${frame_prefix}joint_tcp_fixed" type="fixed">
          <parent link="${frame_prefix}tool0"/>
          <child link="${frame_prefix}rg6_base_link"/>
          <origin rpy="0 0 0" xyz="0 0.0 0.0"/>
      </joint>
    </xacro:if>

    <!-- Robotiq 2F-85 -->
    <xacro:if value="${end_effector == '2f85'}">  
      <xacro:robotiq_gripper
            name="robotiq_2f_85"
            prefix="${frame_prefix}gripper_"
            parent="${frame_prefix}tool0"
            sim_ignition="true"
            include_ros2_control="true">
            <origin xyz="0.0 0 0" rpy="0 0 0"/>
        </xacro:robotiq_gripper>
    </xacro:if>

    <!-- Screwdriver (baked-in path kept for backward compatibility; unused when detachable) -->
    <xacro:if value="${end_effector == 'screwdriver'}">
        <xacro:sd_35_screwdriver
            scale="0.001"
            parent="${frame_prefix}tool0"
            xyz="0 0.095 0.065"
            rpy="3.14 0 0"
        />
    </xacro:if>

    <xacro:if value="$(arg gazebo_ignition)">
      <xacro:include
        filename="$(find ur_simulation_gz)/urdf/ur_gz.ros2_control.xacro" />
      <xacro:ur_ros2_control
        name="arm"
        tf_prefix="${frame_prefix}"
        initial_positions="${initial_positions}" />
    </xacro:if>
  </xacro:macro>
</robot>
